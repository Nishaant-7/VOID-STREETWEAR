{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "hero_slides": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || auth.token.email == 'admin@void.com')"
    },

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (auth.uid == $uid && newData.child('uid').val() == $uid && (newData.child('role').val() == 'customer' || (auth.token.email == 'admin@void.com' && newData.child('role').val() == 'admin'))))",
        ".validate": "newData.hasChildren(['uid', 'email', 'role']) && newData.child('uid').val() == $uid && (newData.child('role').val() == 'customer' || (newData.child('role').val() == 'admin' && (auth.token.email == 'admin@void.com' || root.child('users').child(auth.uid).child('role').val() == 'admin')))"
      }
    },

    "sales_history": {
      ".read": "auth != null",
      "$orderId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || data.child('customerUid').val() == auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (newData.child('customerUid').val() == auth.uid && (!data.exists() || data.child('customerUid').val() == auth.uid)))"
      }
    },

    "lorry_batches": {
      ".read": "auth != null",
      "$batchId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (newData.child('createdByUid').val() == auth.uid && (!data.exists() || data.child('createdByUid').val() == auth.uid)))"
      }
    },

    "notifications": {
      ".read": "auth != null",
      "$notificationId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || newData.child('userId').val() == auth.token.email)"
      }
    },

    "otp_logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".write": "auth != null",
      ".validate": "newData.hasChildren()"
    }
  }
}
